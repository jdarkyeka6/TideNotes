APP_IDENTIFIER = "com.jdarkyeka6.TideNotes"
APP_NAME = "TideNotes"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "TideNotes.xcodeproj")

platform :ios do
  desc "Build TideNotes with Apple cloud signing and upload it to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    missing = []
    missing << "ASC_KEY_ID" if key_id.empty?
    missing << "ASC_ISSUER_ID" if issuer_id.empty?
    missing << "APPLE_TEAM_ID" if team_id.empty?
    missing << "ASC_KEY_CONTENT" if ENV["ASC_KEY_CONTENT"].to_s.strip.empty?
    UI.user_error!("Missing Apple CI secret(s): #{missing.join(', ')}") unless missing.empty?

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text = if raw.include?("BEGIN PRIVATE KEY")
      raw
    else
      require "base64"
      Base64.decode64(raw)
    end

    UI.user_error!("ASC_KEY_CONTENT is not a valid .p8 private key") unless key_text.include?("BEGIN PRIVATE KEY")

    key_path = File.expand_path("~/tidenotes_asc_api_key.p8")
    File.write(key_path, key_text)
    File.chmod(0600, key_path)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    require "spaceship"

    unless Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
      UI.message("Registering #{APP_IDENTIFIER} in Apple Developer...")
      Spaceship::ConnectAPI::BundleId.create(
        name: APP_NAME,
        identifier: APP_IDENTIFIER,
        platform: "IOS"
      )
    end

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    unless app
      UI.user_error!(
        "APP_STORE_RECORD_MISSING: Create an iOS app named '#{APP_NAME}' in App Store Connect using bundle ID '#{APP_IDENTIFIER}', then re-run this workflow."
      )
    end

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: latest + 1
    )

    archive_path = File.join(ROOT, "build/TideNotes.xcarchive")
    export_path = File.join(ROOT, "build/export")
    export_plist = File.join(ROOT, "build/ExportOptions.plist")

    FileUtils.mkdir_p(File.dirname(archive_path))
    FileUtils.rm_rf(archive_path)
    FileUtils.rm_rf(export_path)

    UI.message("Creating unsigned archive for cloud signing...")
    sh(
      "xcodebuild",
      "-project", PROJECT,
      "-scheme", "TideNotes",
      "-configuration", "Release",
      "-destination", "generic/platform=iOS",
      "-archivePath", archive_path,
      "CODE_SIGNING_ALLOWED=NO",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGN_IDENTITY=",
      "archive"
    )

    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>signingStyle</key>
        <string>automatic</string>
        <key>teamID</key>
        <string>#{team_id}</string>
        <key>manageAppVersionAndBuildNumber</key>
        <false/>
        <key>uploadSymbols</key>
        <true/>
      </dict>
      </plist>
    PLIST

    UI.message("Exporting with Apple cloud-managed signing...")
    sh(
      "xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", export_path,
      "-exportOptionsPlist", export_plist,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", key_id,
      "-authenticationKeyIssuerID", issuer_id
    )

    ipa = Dir[File.join(export_path, "*.ipa")].first
    UI.user_error!("Cloud signing export completed but no IPA was produced.") unless ipa

    FileUtils.cp(ipa, File.join(ROOT, "TideNotes.ipa"))

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
